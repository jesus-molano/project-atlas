{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "exact-figma-outranks-atlas-and-redesign-request",
      "input": {
        "scope": "page",
        "hasExistingProject": true,
        "hasExactFigma": true,
        "exactFigma": {
          "fileKey": "file-exact",
          "nodeId": "42:7",
          "url": "figma://file-exact/42:7"
        },
        "explicitRedesign": true,
        "references": [
          {
            "id": "atlas-similar-frame",
            "compatibleWithProject": true,
            "facets": ["hierarchy"]
          }
        ]
      },
      "expected": {
        "mode": "fidelity",
        "inventionBudget": 0,
        "explorationRequired": false,
        "previewCount": 0,
        "visualAuthority": "exact-figma",
        "atlasCandidateCanReplaceExactFigma": false
      }
    },
    {
      "id": "existing-component-inherits-and-compares-two",
      "input": {
        "scope": "component",
        "hasExistingProject": true,
        "hasExactFigma": false,
        "visualDecision": "open",
        "references": [
          {
            "id": "compatible-density-reference",
            "compatibleWithProject": true,
            "facets": ["density"]
          },
          {
            "id": "incompatible-brand-reference",
            "compatibleWithProject": false,
            "facets": ["typography", "color-role"]
          }
        ]
      },
      "expected": {
        "mode": "inherit",
        "inventionBudget": 1,
        "explorationRequired": true,
        "previewCount": 2,
        "visualAuthority": "existing-system",
        "acceptedReferences": ["compatible-density-reference"],
        "rejectedReferences": ["incompatible-brand-reference"]
      }
    },
