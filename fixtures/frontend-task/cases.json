{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "repository-and-conversation",
      "request": "Añade estado vacío con reintento a la lista de gastos.",
      "sources": ["conversation", "repository"],
      "expected": {
        "atlas": "optional-use-if-valuable",
        "figma": "skip",
        "readyForDevRequired": false,
        "questionMode": "none",
        "gate": "continue-unless-behavior-is-ambiguous"
      }
    },
    {
      "id": "personal-figma-without-dev-mode",
      "request": "Añade cupón en checkout móvil.",
      "sources": ["conversation", "repository", "figma-file"],
      "fixture": "../figma/personal-no-dev-mode.xml",
      "expected": {
        "atlas": "compact-context",
        "figma": "map-rank-confirm",
        "topNode": "60:2",
        "readyForDevRequired": false,
        "questionMode": "native-selector-when-available",
        "gate": "confirm-design-target"
      }
    },
    {
      "id": "direct-figma-node",
      "request": "Implementa este frame.",
      "sources": ["conversation", "repository", "figma-node-url"],
      "expected": {
        "atlas": "compact-context",
        "figma": "inspect-confirmed-node",
        "readyForDevRequired": false,
        "questionMode": "none",
        "gate": "skip-candidate-selection"
      }
    },
    {
      "id": "jira-without-confluence-or-figma",
      "request": "Prepara la tarea SHOP-142.",
      "sources": ["conversation", "repository", "jira"],
      "expected": {
        "atlas": "compact-context",
        "figma": "skip",
        "readyForDevRequired": false,
        "questionMode": "none-if-ticket-readable",
        "gate": "ask-only-impact-decisions"
      }
    },
    {
      "id": "conflicting-sources",
      "request": "El ticket permite cerrar el modal pero el frame confirmado no tiene cierre.",
      "sources": ["conversation", "repository", "jira", "figma-node-url"],
      "expected": {
        "atlas": "compact-context",
        "figma": "inspect-confirmed-node",
        "readyForDevRequired": false,
        "questionMode": "native-selector-when-available",
        "gate": "decision-required-with-evidence-and-recommendation"
      }
    },
    {
      "id": "high-risk-persistence-choice",
      "request": "Add a secure device enrollment flow. One source implies immediate persistence while the screen also has Save and Cancel.",
      "sources": ["conversation", "repository", "specification", "design-node-url"],
      "expected": {
        "risk": "high",
        "checkpoint": "required-before-edit",
        "decision": "immediate-persistence-vs-save",
        "questionMode": "native-selector-or-one-chat-question",
        "maxQuestions": 3
      }
    },
    {
      "id": "high-risk-urls-without-decision",
      "request": "Implement this authentication change using the linked ticket, specification, and design.",
      "sources": ["conversation", "repository", "ticket-url", "specification-url", "design-node-url"],
      "expected": {
        "risk": "high",
        "checkpoint": "required-before-edit",
        "linksCountAsConfirmation": false,
        "questionMode": "native-selector-or-one-chat-question"
      }
    },
    {
      "id": "high-risk-current-turn-confirmed",
      "request": "Use immediate persistence for enrollment and let Cancel revert only the pending toggle. Proceed with that decision.",
      "sources": ["conversation", "repository"],
      "expected": {
        "risk": "high",
        "checkpoint": "satisfied-by-current-turn-confirmation",
        "confirmedDecision": "immediate-persistence",
        "questionMode": "none-for-confirmed-decision"
      }
    },
    {
      "id": "all-explicit-sources",
      "request": "Implementa el ticket UI-142 usando la especificación y el frame enlazados.",
      "sources": ["conversation", "repository", "jira", "confluence", "figma-node-url"],
      "capabilities": ["atlassian-rovo", "figma", "github", "project-atlas"],
      "expected": {
        "followOnlyExplicitRelations": true,
        "atlas": "optional-use-if-valuable",
        "questionMode": "none",
        "gate": "continue-unless-sources-conflict"
      }
    },
    {
      "id": "required-figma-capability-unavailable",
      "request": "Reproduce exactamente el diseño del frame indicado.",
      "sources": ["conversation", "repository", "figma-node-url"],
      "capabilities": ["project-atlas"],
      "expected": {
        "figmaClassification": "unavailable",
        "questionMode": "native-selector-or-one-chat-question",
        "options": ["add-link-or-selection", "stop-preparation"],
        "gate": "do-not-invent-design"
      }
    },
    {
      "id": "atlas-unavailable",
      "request": "Añade un aviso accesible usando los patrones existentes.",
      "sources": ["conversation", "repository"],
      "capabilities": [],
      "expected": {
        "atlas": "optional-unavailable",
        "questionMode": "none",
        "gate": "continue-with-repository-search"
      }
    },
    {
      "id": "non-visual-change",
      "request": "Corrige el tipo del payload emitido por el formulario.",
      "sources": ["conversation", "repository"],
      "capabilities": ["figma", "project-atlas"],
      "expected": {
        "figmaClassification": "not-applicable",
        "accessFigma": false,
        "questionMode": "none",
        "gate": "continue"
      }
    },
    {
      "id": "plan-mode-native-selector",
      "request": "Prepara este cambio visual; puedo aportar el ticket o el diseño.",
      "sources": ["conversation", "repository"],
      "capabilities": ["request_user_input", "atlassian-rovo", "figma"],
      "expected": {
        "questionMode": "native-selector",
        "maxQuestions": 3,
        "defaultOption": "use-detected-sources"
      }
    },
    {
      "id": "default-mode-question-fallback",
      "request": "Implementa el diseño exacto, pero todavía no he enviado el frame.",
      "sources": ["conversation", "repository"],
      "capabilities": [],
      "expected": {
        "figmaClassification": "required",
        "questionMode": "one-chat-question",
        "customUi": false,
        "gate": "wait-for-material-source"
      }
    },
    {
      "id": "continue-dirty-worktree",
      "request": "Continúa y termina lo pendiente.",
      "sources": ["conversation", "repository", "prior-outcome"],
      "expected": {
        "mode": "continue",
        "inspectGitDiff": true,
        "brief": "delta-only",
        "preserveExistingChanges": true,
        "repeatOnboarding": false,
        "repeatGate": "only-if-behavior-or-material-decision-changed"
      }
    },
    {
      "id": "correct-after-failed-validation",
      "request": "Corrige el fallo de validación sin rehacer lo que ya funciona.",
      "sources": ["conversation", "repository", "prior-outcome"],
      "expected": {
        "mode": "correct",
        "retrieve": "affected-evidence-only",
        "preserveExistingChanges": true,
        "repeatOnboarding": false
      }
    }
  ]
}
