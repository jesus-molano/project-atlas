{
  "name": "component-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build && pnpm --filter @component-atlas/viewer build",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "dev:viewer": "pnpm --filter @component-atlas/viewer dev",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "atlas": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
